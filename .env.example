# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` (ou `.env.local`) e preencha os valores.
# NUNCA comite `.env` / `.env.local` — eles estão no .gitignore e o repositório
# é público. Em produção (Vercel) as variáveis vão no painel do projeto.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados (obrigatório)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segredo das sessões de login (obrigatório em produção — mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# FinBot (chat com IA) — provedor compatível com a API da Anthropic.
# Deixe em branco para usar os fallbacks automáticos do ambiente:
#   base: USER_LLM_BASE_URL → BTY_LLM_SERVER_BASE_URL → REACTUS_BASE_URL + /v1
#   key:  USER_LLM_API_KEY  → BTY_LLM_SERVER_API_KEY  → HAPPYSEEDS_KEY
USER_LLM_BASE_URL=
USER_LLM_API_KEY=
USER_LLM_MODEL=claude-sonnet-4.6

# Gateway de IA / plataforma
BTY_LLM_SERVER_BASE_URL=
BTY_LLM_SERVER_API_KEY=
REACTUS_BASE_URL=https://reactus-api.happyseeds.ai

# Happy Seeds (marca d'água + PROJECT_ID)
HAPPYSEEDS_PROJECT_ID=
HAPPYSEEDS_KEY=

# Umami Analytics (opcional — só carrega em produção se preenchido)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
