DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_web_template
LOG_DIR=./vibe-web-template

LLM_BASE_URL=example
LLM_API_KEY=xxx

# FinBot (chat) — provedor Anthropic-compatível.
# Deixe em branco para usar os fallbacks automáticos do ambiente:
#   base: USER_LLM_BASE_URL → BTY_LLM_SERVER_BASE_URL → REACTUS_BASE_URL + /v1
#   key:  USER_LLM_API_KEY  → BTY_LLM_SERVER_API_KEY  → HAPPYSEEDS_KEY
# Preencha apenas se quiser apontar para outro provedor.
USER_LLM_BASE_URL=
USER_LLM_API_KEY=
USER_LLM_MODEL=claude-sonnet-4.6

# Reactus API 根地址（仅 scheme + host，不含路径；与沙箱内 REACTUS_BASE_URL 一致）
REACTUS_BASE_URL=https://dev-reactus-api.happyseeds.ai

# Happy Seeds（右下角水印校验与 PROJECT_ID）
HAPPYSEEDS_PROJECT_ID=

# Umami Analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://your-umami-domain/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-website-id"
